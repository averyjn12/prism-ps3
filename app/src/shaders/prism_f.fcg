/* Prism v0.67: the one fragment program: texel x colour. Plain shapes sample the white band of the
 * font texture; text samples its coverage (alpha); covers and icons their own texture. */
void main(float2 texcoord : TEXCOORD0,
          float4 color : TEXCOORD1,

          uniform sampler2D texture,

          out float4 oColor : COLOR0)
{
	oColor = tex2D(texture, texcoord) * color;
}
